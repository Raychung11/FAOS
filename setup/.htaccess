# AdvisorOS — setup directory.
# Deny everything by default, but allow the one-time web installer and
# the demo-data seeder. Delete this whole directory once the platform
# is installed and you have finished testing.

<IfModule mod_authz_core.c>
  Require all denied
  <FilesMatch "^(install|demo_seed|valuation_seed)\.php$">
    Require all granted
  </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
  <FilesMatch "^(install|demo_seed|valuation_seed)\.php$">
    Order allow,deny
    Allow from all
  </FilesMatch>
</IfModule>
