# AdvisorOS environment configuration
# Copy this file to .env and adjust values for your environment.

APP_NAME="AdvisorOS"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Kuala_Lumpur

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=advisoros
DB_USER=advisoros
DB_PASS=change-me
DB_CHARSET=utf8mb4

# Security
SESSION_NAME=advisoros_session
SESSION_LIFETIME=3600
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Mail (PHPMailer - Phase 2)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@advisoros.app
MAIL_FROM_NAME="AdvisorOS"

# AI assistant (optional — leave AI_API_KEY blank for offline draft mode)
# AI_PROVIDER: anthropic | openai
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=

# Uploads
MAX_UPLOAD_MB=10
