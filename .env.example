# ============================================================
# FAOS - AI Central Kitchen + QR Kiosk Sales BOS
# Copy this file to ".env" and adjust for your environment.
# ============================================================

APP_NAME="FAOS BOS"
APP_ENV=production            # production | local
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_KEY=                      # 32+ char random string (used for CSRF/session signing)

# ---- Database (MySQL 8) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=faos_bos
DB_USER=faos
DB_PASS=secret
DB_CHARSET=utf8mb4

# ---- Session / Security ----
SESSION_NAME=faos_session
SESSION_LIFETIME=43200        # seconds (12h shift friendly)
SESSION_SECURE=false          # set true behind HTTPS
SESSION_SAMESITE=Lax

# ---- AI Provider (forecasting / assistant) ----
# Provider: claude | openai | none  (none = built-in heuristic forecasting only)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=claude-opus-4-7
AI_BASE_URL=

# ---- Locale / Currency ----
CURRENCY=MYR
CURRENCY_SYMBOL=RM
